package "pkg/config"

import "pkg/std/errors"
import "pkg/std/io"
import "pkg/std/os"
import "pkg/std/strconv"
import "pkg/std/strings"
import "pkg/stdx/fmt"

// NewParseError returns a ParseError at line (1-based) rooted in base.
func NewParseError(line int, detail @[]readonly char, base @errors.Error) @ParseError {
	var e @ParseError = make(ParseError)
	e.Line = line
	e.Detail = detail
	e.base = base
	return e
}

// Error renders "line N: detail".
func (e @ParseError) Error() @[]readonly char {
	return fmt.Sprintf("line %d: %s", e.Line, e.Detail)
}

// Unwrap returns the base this error roots in.
func (e @ParseError) Unwrap() @errors.Error {
	return e.base
}

// isSpace reports whether c is a space or tab.
func isSpace(c char) bool {
	return c == ' ' || c == '\t'
}

// trim returns the text without leading or trailing spaces and tabs. The result
// is a sub-slice sharing text's backing — a view, not a copy.
func trim(text @[]readonly char) @[]readonly char {
	var lo int = 0
	var hi int = len(text)
	for lo < hi && isSpace(text[lo]) {
		lo = lo + 1
	}
	for hi > lo && isSpace(text[hi - 1]) {
		hi = hi - 1
	}
	return text[lo:hi]
}

// textEq reports whether two texts hold the same bytes; slices have no ==.
func textEq(a @[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) {
		return false
	}
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] {
			return false
		}
	}
	return true
}

// applyLine parses one `key = value` line into cfg, returning the failure if
// there is one.
func applyLine(cfg @Config, line @[]readonly char, num int) @errors.Error {
	var none @errors.Error
	var eq int = -1
	for i := 0; i < len(line); i++ {
		if line[i] == '=' {
			eq = i
			break
		}
	}
	if eq < 0 {
		var e @ParseError = NewParseError(num, "expected key = value", errors.BadData)
		return e
	}
	var key @[]readonly char = trim(line[0:eq])
	var val @[]readonly char = trim(line[eq + 1:len(line)])
	if textEq(key, "name") {
		cfg.Name = val
		return none
	}
	if textEq(key, "port") {
		n, err := strconv.Atoi(val)
		if present(err) {
			// A fresh error under the base we want, with the cause's text folded
			// into the message: with one Unwrap link, wrapping would inherit the
			// cause's classification instead of setting this one.
			var detail @[]readonly char = fmt.Sprintf("port: %s", err.Error())
			var e @ParseError = NewParseError(num, detail, errors.BadData)
			return e
		}
		cfg.Port = n
		return none
	}
	if textEq(key, "debug") {
		b, err := strconv.ParseBool(val)
		if present(err) {
			var detail @[]readonly char = fmt.Sprintf("debug: %s", err.Error())
			var e @ParseError = NewParseError(num, detail, errors.BadData)
			return e
		}
		cfg.Debug = b
		return none
	}
	var unknown @[]readonly char = fmt.Sprintf("unknown key %q", key)
	var e @ParseError = NewParseError(num, unknown, errors.InvalidArgument)
	return e
}

// Parse reads text as a sequence of `key = value` lines.
func Parse(text @[]readonly char) (@Config, @errors.Error) {
	var none @errors.Error
	var cfg @Config = make(Config)
	cfg.Name = ""
	var start int = 0
	var num int = 0
	for i := 0; i <= len(text); i++ {
		if i < len(text) && text[i] != '\n' {
			continue
		}
		num = num + 1
		var line @[]readonly char = trim(text[start:i])
		start = i + 1
		if len(line) == 0 || line[0] == '#' {
			continue
		}
		var err @errors.Error = applyLine(cfg, line, num)
		if present(err) {
			return cfg, err
		}
	}
	if len(cfg.Name) == 0 {
		return cfg, errors.Rooted(errors.NotFound, "required key 'name' is missing")
	}
	return cfg, none
}

// readFile returns the whole contents of path.
func readFile(path *[]readonly char) (@[]readonly char, @errors.Error) {
	var none @errors.Error
	f, err := os.Open(path)
	if present(err) {
		return "", err
	}
	var b @strings.Builder = strings.NewBuilder()
	var buf @[]uint8 = make_slice(uint8, 512)
	for {
		n, rerr := f.Read(buf)
		if n > 0 {
			_, _ = b.Write(buf[0:n])
		}
		if present(rerr) {
			_ = f.Close()
			if io.IsEOF(rerr) {
				return b.String(), none
			}
			return b.String(), rerr
		}
	}
	return b.String(), none
}

// Load reads the file at path and parses it.
func Load(path *[]readonly char) (@Config, @errors.Error) {
	text, err := readFile(path)
	if present(err) {
		// Wrap: the caller gets "reading <path>: <cause>" AND keeps every
		// classification the cause carried.
		var ctx @[]readonly char = fmt.Sprintf("reading %s", path)
		var cfg @Config = make(Config)
		return cfg, errors.Wrap(err, ctx)
	}
	return Parse(text)
}
