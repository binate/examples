#!/usr/bin/env bnrun
// greet is one source file that runs three ways: directly as `./main.bn args…`
// through the kernel, as `bnrun main.bn args…` through bni's `-x` script mode,
// and as a compiled binary. Nothing about the program changes between them.
//
// The `#!` line above is why it can be the first: the toolchain's lexer skips a
// shebang line at offset 0, in bnc as well as bni, so the file stays valid
// Binate. What the line names is a launcher of this example's own (bin/bnrun) —
// see the README for why it cannot name the interpreter directly.
package "main"

import "pkg/std/os"
import "pkg/stdx/fmt"

// endsWithBn reports whether name ends in ".bn" — how the program tells a script
// run from a compiled one, since argv[0] names whichever actually started it.
func endsWithBn(name readonly @[]readonly char) bool {
	var suffix @[]readonly char = ".bn"
	if len(name) < len(suffix) {
		return false
	}
	var start int = len(name) - len(suffix)
	for i := 0; i < len(suffix); i++ {
		if name[start + i] != suffix[i] {
			return false
		}
	}
	return true
}

// main greets each argument it was given.
func main() {
	var args @[]readonly @[]readonly char = os.Args()
	fmt.Printf("argc %d\n", len(args))

	// Element 0 is the program name, and what it holds says how the program was
	// started: the SCRIPT path under `bni -x` (so it ends in ".bn"), and the
	// BINARY path when compiled. Reporting which kind it is keeps the output
	// machine-independent — the path itself would not be.
	fmt.Printf("started from source: %t\n", endsWithBn(args[0]))

	for i := 1; i < len(args); i++ {
		// The copy into an unqualified local is required, not stylistic:
		// os.Args() is fully readonly, so an element has type
		// `readonly @[]readonly char`, and fmt has no case for a
		// readonly-qualified slice — printing args[i] directly renders
		// `%!?(unknown)`. A tracked gap; see ../TODO.md.
		var arg @[]readonly char = args[i]
		fmt.Printf("hello, %s\n", arg)
	}
	if len(args) == 1 {
		fmt.Println("(no arguments)")
	}
}
