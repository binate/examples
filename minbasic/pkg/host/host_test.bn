package "pkg/host"

import "pkg/basic/io"
import "pkg/builtins/testing"
import "pkg/std/errors"
import "pkg/std/os"

// scratchDir is the directory these tests write into. A `const` cannot hold it —
// const is compile-time scalars only — so it is a function returning the literal.
func scratchDir() @[]readonly char {
	return "/tmp/binate-minbasic-host-test"
}

// textEq reports whether two texts hold the same bytes; slices have no ==.
func textEq(a *[]readonly char, want *[]readonly char) bool {
	if len(a) != len(want) {
		return false
	}
	for i := 0; i < len(a); i++ {
		if a[i] != want[i] {
			return false
		}
	}
	return true
}

// writeFile creates scratch/<name> holding text, and returns its path. It is the
// fixture the file-backed tests read back.
func writeFile(name *[]readonly char, text *[]readonly char) @[]char {
	var dir @[]readonly char = scratchDir()
	_ = os.MkdirAll(dir, cast(os.FileMode, 0o755))
	var path @[]char = make_slice(char, len(dir) + 1 + len(name))
	var k int = 0
	for i := 0; i < len(dir); i++ {
		path[k] = dir[i]
		k = k + 1
	}
	path[k] = '/'
	k = k + 1
	for i := 0; i < len(name); i++ {
		path[k] = name[i]
		k = k + 1
	}
	f, err := os.Create(path)
	if present(err) {
		return path
	}
	_, _ = f.Write(text)
	_ = f.Close()
	return path
}

// remove deletes a fixture file, then tries the scratch directory itself.
// Removing a non-empty directory fails, so the attempt is a no-op until the last
// fixture is gone and then succeeds — which cleans up without a teardown hook or
// any ordering between tests. Both failures are ignored: this is cleanup, not an
// assertion.
func remove(path *[]readonly char) {
	var e @errors.Error = os.Remove(path)
	_ = e
	var d @errors.Error = os.Remove(scratchDir())
	_ = d
}

// openFile opens a path for reading, or reports that it could not.
func openFile(path *[]readonly char) (@os.File, bool) {
	f, err := os.Open(path)
	return f, !present(err)
}

// TestReadFileRoundTrip checks the ordinary case: what was written comes back.
func TestReadFileRoundTrip() testing.TestResult {
	var path @[]char = writeFile("round.txt", "10 PRINT \"HI\"\n20 END\n")
	text, ok := ReadFile(path)
	remove(path)
	if !ok {
		return "an existing file reads"
	}
	if !textEq(text, "10 PRINT \"HI\"\n20 END\n") {
		return "byte for byte"
	}
	return ""
}

// TestReadFileEmpty checks that an empty file is a success with no bytes, not a
// failure — a BASIC program file may legitimately be empty.
func TestReadFileEmpty() testing.TestResult {
	var path @[]char = writeFile("empty.txt", "")
	text, ok := ReadFile(path)
	remove(path)
	if !ok {
		return "an empty file still reads"
	}
	if len(text) != 0 {
		return "with no content"
	}
	return ""
}

// TestReadFileCrossesChunks is the test the chunked read loop exists for: a file
// larger than READ_CHUNK takes several Read calls, and the accumulator must join
// them in order with nothing dropped or repeated at a boundary.
func TestReadFileCrossesChunks() testing.TestResult {
	// A repeating pattern with a period that does not divide the chunk size, so
	// a boundary lands mid-pattern and any slip shows up as a mismatch.
	var size int = READ_CHUNK * 2 + 137
	var big @[]char = make_slice(char, size)
	for i := 0; i < size; i++ {
		big[i] = cast(char, cast(int, 'a') + i % 7)
	}
	var path @[]char = writeFile("big.txt", big)
	text, ok := ReadFile(path)
	remove(path)
	if !ok {
		return "a multi-chunk file reads"
	}
	if len(text) != size {
		return "every byte comes back"
	}
	for i := 0; i < size; i++ {
		if text[i] != big[i] {
			return "in order, across the chunk boundaries"
		}
	}
	return ""
}

// TestReadFileKeepsEveryByte checks that the read is byte-transparent: a NUL and
// a high byte survive, since char is uint8 and nothing is treated as a terminator.
func TestReadFileKeepsEveryByte() testing.TestResult {
	var raw @[]char = make_slice(char, 4)
	raw[0] = 'a'
	raw[1] = cast(char, 0)
	raw[2] = cast(char, 255)
	raw[3] = 'b'
	var path @[]char = writeFile("bytes.bin", raw)
	text, ok := ReadFile(path)
	remove(path)
	if !ok || len(text) != 4 {
		return "all four bytes read"
	}
	if text[1] != cast(char, 0) || text[2] != cast(char, 255) {
		return "a NUL and a high byte survive"
	}
	return ""
}

// TestReadFileMissing checks the failure path: a missing file is (empty, false)
// rather than an abort.
func TestReadFileMissing() testing.TestResult {
	text, ok := ReadFile("/definitely/not/here.bas")
	if ok {
		return "a missing file does not read"
	}
	if len(text) != 0 {
		return "and yields no content"
	}
	return ""
}

// TestReadLineSplitsLines checks the line assembly: the terminator is stripped,
// an empty line is a line, and end-of-input latches.
func TestReadLineSplitsLines() testing.TestResult {
	var path @[]char = writeFile("lines.txt", "one\n\ntwo\n")
	f, ok := openFile(path)
	if !ok {
		return "the fixture opens"
	}
	var r @LineReader = NewFileLineReader(f)
	var a LineResult = r.ReadLine()
	var b LineResult = r.ReadLine()
	var c LineResult = r.ReadLine()
	var d LineResult = r.ReadLine()
	_ = f.Close()
	remove(path)
	if !textEq(a.Line, "one") || a.Eof {
		return "the first line, without its newline"
	}
	if len(b.Line) != 0 || b.Eof {
		return "an empty line is a line, not end of input"
	}
	if !textEq(c.Line, "two") || c.Eof {
		return "the last terminated line"
	}
	if len(d.Line) != 0 || !d.Eof {
		return "then end of input"
	}
	return ""
}

// TestReadLineUnterminatedTail checks the contract's fussiest case: a final line
// with no trailing newline is returned as content, and only the call AFTER it
// reports end of input.
func TestReadLineUnterminatedTail() testing.TestResult {
	var path @[]char = writeFile("tail.txt", "first\nlast")
	f, ok := openFile(path)
	if !ok {
		return "the fixture opens"
	}
	var r @LineReader = NewFileLineReader(f)
	var a LineResult = r.ReadLine()
	var b LineResult = r.ReadLine()
	var c LineResult = r.ReadLine()
	_ = f.Close()
	remove(path)
	if !textEq(a.Line, "first") || a.Eof {
		return "the terminated line"
	}
	if !textEq(b.Line, "last") || b.Eof {
		return "the unterminated tail is content, not end of input"
	}
	if len(c.Line) != 0 || !c.Eof {
		return "the next call reports end of input"
	}
	return ""
}

// TestReadLineStripsCarriageReturns checks that a CRLF file reads the same as an
// LF one — a BASIC listing typed on another system should not grow stray bytes.
func TestReadLineStripsCarriageReturns() testing.TestResult {
	var path @[]char = writeFile("crlf.txt", "10 PRINT\r\n20 END\r\n")
	f, ok := openFile(path)
	if !ok {
		return "the fixture opens"
	}
	var r @LineReader = NewFileLineReader(f)
	var a LineResult = r.ReadLine()
	var b LineResult = r.ReadLine()
	_ = f.Close()
	remove(path)
	if !textEq(a.Line, "10 PRINT") || !textEq(b.Line, "20 END") {
		return "the carriage return is dropped with the newline"
	}
	return ""
}

// TestReadLineEmptyFile checks that a file with nothing in it reports end of
// input immediately, and keeps reporting it.
func TestReadLineEmptyFile() testing.TestResult {
	var path @[]char = writeFile("none.txt", "")
	f, ok := openFile(path)
	if !ok {
		return "the fixture opens"
	}
	var r @LineReader = NewFileLineReader(f)
	var a LineResult = r.ReadLine()
	var b LineResult = r.ReadLine()
	_ = f.Close()
	remove(path)
	if !a.Eof || len(a.Line) != 0 {
		return "an empty file is end of input at once"
	}
	if !b.Eof {
		return "and the latch keeps it that way"
	}
	return ""
}

// scriptReader is a LineReader with no file behind it, for testing the ConsoleIn
// adapter in isolation: it hands out prepared lines, then reports end of input.
type scriptReader struct {
	lines @[]@[]char
	next  int
}

// ReadLine yields the next prepared line, or the end-of-input result.
func (s @scriptReader) ReadLine() LineResult {
	var res LineResult
	if s.next >= len(s.lines) {
		res.Line = make_slice(char, 0)
		res.Eof = true
		return res
	}
	res.Line = s.lines[s.next]
	res.Eof = false
	s.next = s.next + 1
	return res
}

impl @scriptReader : LineReader

// newScript returns a LineReader over the given lines.
func newScript(lines @[]@[]char) @LineReader {
	var s @scriptReader = make(scriptReader)
	s.lines = lines
	s.next = 0
	var lr @LineReader = s
	return lr
}

// TestConsoleInForwards checks the adapter: a ConsoleIn built over a LineReader
// carries Text and Eof across verbatim, one reply per line.
func TestConsoleInForwards() testing.TestResult {
	var cin @io.ConsoleIn = NewConsoleIn(newScript(@[]@[]char{"42", ""}))
	var a io.InLine = cin.ReadLine()
	var b io.InLine = cin.ReadLine()
	var c io.InLine = cin.ReadLine()
	if !textEq(a.Text, "42") || a.Eof {
		return "the first reply"
	}
	if len(b.Text) != 0 || b.Eof {
		return "an empty reply is a reply, not end of input"
	}
	if !c.Eof || len(c.Text) != 0 {
		return "then end of input"
	}
	return ""
}

// TestConsoleInSharesOneStream checks the reason NewConsoleIn takes a reader
// rather than making one: a REPL's command loop and program INPUT draw from the
// SAME stream, so a line consumed by one is gone for the other.
func TestConsoleInSharesOneStream() testing.TestResult {
	var shared @LineReader = newScript(@[]@[]char{"first", "second"})
	var cin @io.ConsoleIn = NewConsoleIn(shared)
	var direct LineResult = shared.ReadLine()
	var viaIn io.InLine = cin.ReadLine()
	if !textEq(direct.Line, "first") {
		return "the command loop takes the first line"
	}
	if !textEq(viaIn.Text, "second") {
		return "and INPUT continues from there, not from the start"
	}
	return ""
}

// TestArgsHasProgramSlot checks the shape host.Args() promises its callers:
// element 0 is the program-name slot and the arguments follow.
func TestArgsHasProgramSlot() testing.TestResult {
	var args @[]readonly @[]readonly char = Args()
	if len(args) < 1 {
		return "there is always a program-name slot"
	}
	return ""
}

// TestWriteReturnsCount checks the count the framing writers report. The empty
// write is the one that can be asserted without printing into the test log; a
// real write's bytes are covered by minbasic/sessions, which diffs whole
// transcripts.
func TestWriteReturnsCount() testing.TestResult {
	if WriteStdout("") != 0 {
		return "writing nothing writes no bytes"
	}
	if WriteStderr("") != 0 {
		return "on either stream"
	}
	return ""
}
