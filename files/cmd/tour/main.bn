// tour walks pkg/std/os end to end inside a scratch directory: create and write
// a file, read it back four different ways, stat it, list a directory, then
// rename and remove — checking the failure classifications along the way.
//
// It prints DERIVED facts (counts, comparisons, classifications) rather than
// paths, sizes-in-context, or times, so the output is identical on every machine
// and pins as a fixture. Directory listings are sorted before printing, because
// os.ReadDir returns the directory's own order, which is not one.
//
// The scratch directory is the first argument, or /tmp/binate-files-tour if none
// is given. It is created if missing and emptied on the way out.
package "main"

import "pkg/fio"
import "pkg/std/errors"
import "pkg/std/io"
import "pkg/std/os"
import "pkg/stdx/containers/vec"
import "pkg/stdx/fmt"

// contents is what the tour writes, reads back, and copies. Adjacent string
// literals concatenate at compile time.
var contents @[]readonly char = "Binate reads bytes.\n"
	"A file is a byte stream.\n"

// workDir returns the scratch directory: the first program argument, or a
// default. os.Args()[0] is the program name — a placeholder in a compiled binary
// and the script path under the VM — so arguments start at index 1.
func workDir() @[]readonly char {
	var args @[]readonly @[]readonly char = os.Args()
	if len(args) > 1 {
		return args[1]
	}
	return "/tmp/binate-files-tour"
}

// join returns dir + "/" + name. Binate has no string concatenation operator, so
// building a path is an explicit copy into an owned slice.
func join(dir *[]readonly char, name *[]readonly char) @[]readonly char {
	var out @[]char = make_slice(char, len(dir) + 1 + len(name))
	var k int = 0
	for i := 0; i < len(dir); i++ {
		out[k] = dir[i]
		k = k + 1
	}
	out[k] = '/'
	k = k + 1
	for i := 0; i < len(name); i++ {
		out[k] = name[i]
		k = k + 1
	}
	return out
}

// write creates path and writes text to it, reporting whether every step
// succeeded. Close is explicit: Binate runs no finalizers, so an unclosed File
// leaks its descriptor until the process exits.
func write(path *[]readonly char, text *[]readonly char) bool {
	f, err := os.Create(path)
	if present(err) {
		return false
	}
	n, werr := f.Write(text)
	var cerr @errors.Error = f.Close()
	return !present(werr) && !present(cerr) && n == len(text)
}

// readWithLoop reads a whole file with the classic Read loop, returning the byte
// count. End of input arrives as an ERROR value (io.EOF), not a zero count —
// io.IsEOF is the test, and it matches even if a reader wrapped it in context.
func readWithLoop(path *[]readonly char) int {
	f, err := os.Open(path)
	if present(err) {
		return -1
	}
	var buf @[]uint8 = make_slice(uint8, 8)
	var total int = 0
	for {
		n, rerr := f.Read(buf)
		total = total + n
		if present(rerr) {
			if !io.IsEOF(rerr) {
				total = -1
			}
			break
		}
	}
	_ = f.Close()
	return total
}

// textEq reports whether two texts hold the same bytes; slices have no ==.
func textEq(got @[]readonly char, want *[]readonly char) bool {
	if len(got) != len(want) {
		return false
	}
	for i := 0; i < len(got); i++ {
		if got[i] != want[i] {
			return false
		}
	}
	return true
}

// sortedNames returns the entry names of dir, sorted — os.ReadDir hands back the
// directory's own order, which is not an order anyone should print.
func sortedNames(dir *[]readonly char) @vec.Vec[@[]readonly char] {
	var names @vec.Vec[@[]readonly char] = vec.New[@[]readonly char]()
	entries, err := os.ReadDir(dir)
	if present(err) {
		return names
	}
	for i := 0; i < len(entries); i++ {
		names.Push(entries[i].Name())
	}
	// Insertion sort: a handful of entries, and it keeps the example free of a
	// sorting dependency.
	for i := 1; i < names.Len(); i++ {
		var v @[]readonly char = names.Get(i)
		var j int = i - 1
		for j >= 0 && !lessName(names.Get(j), v) {
			names.Set(j + 1, names.Get(j))
			j = j - 1
		}
		names.Set(j + 1, v)
	}
	return names
}

// lessName orders two names lexicographically by byte.
func lessName(a @[]readonly char, b @[]readonly char) bool {
	var n int = len(a)
	if len(b) < n {
		n = len(b)
	}
	for i := 0; i < n; i++ {
		if a[i] != b[i] {
			return a[i] < b[i]
		}
	}
	return len(a) < len(b)
}

// setup creates the scratch tree: the work directory, two files, and a
// subdirectory, reporting whether MkdirAll was idempotent.
func setup(dir *[]readonly char) bool {
	var perm os.FileMode = cast(os.FileMode, 0o755)
	var e1 @errors.Error = os.MkdirAll(dir, perm)
	// MkdirAll on an existing directory succeeds; plain Mkdir does not.
	var e2 @errors.Error = os.MkdirAll(dir, perm)
	var e3 @errors.Error = os.Mkdir(join(dir, "sub"), perm)
	return !present(e1) && !present(e2) &&
		(!present(e3) || errors.Is(e3, errors.AlreadyExists))
}

// cleanup removes everything the tour made, so a rerun starts from nothing.
func cleanup(dir *[]readonly char) {
	entries, err := os.ReadDir(dir)
	if present(err) {
		return
	}
	for i := 0; i < len(entries); i++ {
		_ = os.Remove(join(dir, entries[i].Name()))
	}
	_ = os.Remove(dir)
}

// main runs the tour: setup, write, read four ways, stat, list, rename, remove.
func main() {
	var dir @[]readonly char = workDir()
	cleanup(dir)
	fmt.Printf("setup: %t\n", setup(dir))

	var path @[]readonly char = join(dir, "notes.txt")
	fmt.Printf("write: %t\n", write(path, contents))

	// Four ways to read the same file.
	fmt.Printf("read loop: %d bytes\n", readWithLoop(path))

	f, _ := os.Open(path)
	all, aerr := fio.ReadAll(f)
	_ = f.Close()
	fmt.Printf("fio.ReadAll: %d bytes, matches: %t, err: %t\n",
		len(all), textEq(all, contents), present(aerr))

	// Seek moves the kernel's own stream position; ReadAt ignores it entirely,
	// so the two do not interfere.
	g, _ := os.Open(path)
	pos, _ := g.Seek(7, os.SeekStart)
	var word @[]uint8 = make_slice(uint8, 5)
	nw, _ := g.Read(word)
	var head @[]uint8 = make_slice(uint8, 6)
	nh, _ := g.ReadAt(head, 0)
	after, _ := g.Seek(0, os.SeekCurrent)
	fmt.Printf("seek to %d read %d [%s]; ReadAt %d [%s]; position still %d: %t\n",
		pos, nw, word, nh, head, after, after == pos + cast(int64, nw))
	end, _ := g.Seek(0, os.SeekEnd)
	fmt.Printf("seek to end: %t\n", end == cast(int64, len(contents)))
	_ = g.Close()

	// A File is an io.Reader and an io.Writer, so copying one to another is the
	// generic fio.Copy — neither side knows it is talking to a file.
	var copyPath @[]readonly char = join(dir, "copy.txt")
	src, _ := os.Open(path)
	dst, _ := os.Create(copyPath)
	copied, cerr := fio.Copy(dst, src)
	_ = src.Close()
	_ = dst.Close()
	var back @[]readonly char = ""
	h, herr := os.Open(copyPath)
	if !present(herr) {
		back, _ = fio.ReadAll(h)
		_ = h.Close()
	}
	fmt.Printf("copy: %d bytes, err %t, identical %t\n",
		copied, present(cerr), textEq(back, contents))

	// Stat: a snapshot, not a live view. Permission bits depend on the process
	// umask, so only the stable parts are printed.
	fi, serr := os.Stat(path)
	fmt.Printf("stat: err %t, size matches %t, regular %t, dir %t, mtime self-equal %t\n",
		present(serr), fi.Size() == cast(int64, len(contents)),
		fi.Mode().IsRegular(), fi.IsDir(), fi.ModTime().Equal(fi.ModTime()))
	sub, _ := os.Stat(join(dir, "sub"))
	fmt.Printf("stat sub: dir %t, regular %t\n", sub.IsDir(), sub.Mode().IsRegular())

	// ReadDir reports each entry's type, so "is this a subdirectory?" needs no
	// second call.
	var names @vec.Vec[@[]readonly char] = sortedNames(dir)
	fmt.Print("dir:")
	for i := 0; i < names.Len(); i++ {
		fmt.Printf(" %s", names.Get(i))
	}
	fmt.Println("")

	var renamed @[]readonly char = join(dir, "renamed.txt")
	var rerr @errors.Error = os.Rename(path, renamed)
	_, oldErr := os.Stat(path)
	_, newErr := os.Stat(renamed)
	fmt.Printf("rename: err %t, old gone %t, new there %t\n",
		present(rerr), errors.Is(oldErr, errors.NotFound), !present(newErr))

	// The error hierarchy: a missing path is errors.NotFound, which roots in
	// errors.ConditionsUnmet, so a caller can match at either level.
	_, missing := os.Open(join(dir, "nope.txt"))
	fmt.Printf("open missing: NotFound %t, ConditionsUnmet %t, message [%s]\n",
		errors.Is(missing, errors.NotFound),
		errors.Is(missing, errors.ConditionsUnmet), missing.Error())
	var again @errors.Error = os.Remove(join(dir, "nope.txt"))
	fmt.Printf("remove missing: NotFound %t\n", errors.Is(again, errors.NotFound))
	var nonEmpty @errors.Error = os.Remove(dir)
	fmt.Printf("remove non-empty dir: fails %t\n", present(nonEmpty))

	cleanup(dir)
	_, gone := os.Stat(dir)
	fmt.Printf("cleanup: gone %t\n", errors.Is(gone, errors.NotFound))
}
